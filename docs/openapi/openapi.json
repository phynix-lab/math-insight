      "Common.ErrorBody": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "details": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Common.ValidationIssue"
            }
          }
        }
      },
      "Common.IdPayload": {
        "type": "object",
