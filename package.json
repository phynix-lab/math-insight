{
  "name": "math-insight",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "dev": "pnpm --filter @math-insight/web dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @math-insight/web start",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write \"**/*.{ts,tsx}\""
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1"
  }
}
