{
  "name": "@math-insight/openapi",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsp compile . --warn-as-error && node scripts/generate-markdown.mjs",
    "format": "tsp format \"**/*.tsp\"",
    "typecheck": "tsp compile . --no-emit --warn-as-error"
  },
  "devDependencies": {
    "@scalar/openapi-to-markdown": "^1.7.0",
    "@typespec/compiler": "^1.18.0",
    "@typespec/http": "^1.18.0",
    "@typespec/openapi": "^1.18.0",
    "@typespec/openapi3": "^1.18.0",
    "@typespec/rest": "^0.88.0"
  }
}
