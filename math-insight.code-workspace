{
  "folders": [
    {
      "name": "math-insight",
      "path": "."
    }
  ],
  "settings": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit"
    },
    "prettier.configPath": ".prettierrc",
    "prettier.ignorePath": ".prettierignore",
    "eslint.workingDirectories": ["packages/web"],
    "typescript.tsdk": "packages/web/node_modules/typescript/lib",
    "[typespec]": {
      "editor.defaultFormatter": "typespec.typespec-vscode"
    },
    "[prisma]": {
      "editor.defaultFormatter": "Prisma.prisma"
    }
  },
  "extensions": {
    "recommendations": [
      "esbenp.prettier-vscode",
      "dbaeumer.vscode-eslint",
      "typespec.typespec-vscode",
      "Prisma.prisma"
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Web: Dev",
        "detail": "Chạy máy chủ phát triển Next.js (@math-insight/web) ở chế độ thường",
        "type": "shell",
        "command": "pnpm dev",
        "isBackground": true,
        "problemMatcher": []
      },
      {
        "label": "Web: Dev (Mock)",
        "detail": "Chạy máy chủ phát triển Next.js kèm bật dữ liệu API giả lập (ENABLE_MOCK=true)",
        "type": "shell",
        "command": "pnpm dev",
        "options": {
          "env": {
            "ENABLE_MOCK": "true"
          }
        },
        "isBackground": true,
        "problemMatcher": []
      },
      {
        "label": "OpenAPI: Build (JSON + MD)",
        "detail": "Biên dịch TypeSpec ra file OpenAPI JSON và tạo tài liệu Markdown",
        "type": "shell",
        "command": "pnpm --filter @math-insight/openapi build",
        "problemMatcher": []
      },
      {
        "label": "Web: Generate API (Orval)",
        "detail": "Sinh tự động React Query hooks, MSW mocks và Zod schemas từ OpenAPI bằng Orval",
        "type": "shell",
        "command": "pnpm --filter @math-insight/web generate:api",
        "problemMatcher": []
      },
      {
        "label": "API: Sync All (TypeSpec -> Orval)",
        "detail": "Chạy tuần tự build OpenAPI từ TypeSpec rồi sinh lại API client bằng Orval",
        "dependsOrder": "sequence",
        "dependsOn": [
          "OpenAPI: Build (JSON + MD)",
          "Web: Generate API (Orval)"
        ],
        "problemMatcher": []
      },
      {
        "label": "Workspace: Typecheck",
        "detail": "Kiểm tra kiểu dữ liệu TypeScript và TypeSpec trên toàn bộ workspace",
        "type": "shell",
        "command": "pnpm typecheck",
        "problemMatcher": ["$tsc"]
      },
      {
        "label": "Workspace: Lint",
        "detail": "Kiểm tra quy tắc và lỗi mã nguồn bằng ESLint trên toàn bộ workspace",
        "type": "shell",
        "command": "pnpm lint",
        "problemMatcher": ["$eslint-stylish"]
      },
      {
        "label": "Workspace: Format",
        "detail": "Tự động định dạng lại các file TypeScript/TSX bằng Prettier",
        "type": "shell",
        "command": "pnpm format",
        "problemMatcher": []
      },
      {
        "label": "Workspace: Build",
        "detail": "Build toàn bộ các package trong workspace (task build mặc định)",
        "type": "shell",
        "command": "pnpm build",
        "group": {
          "kind": "build",
          "isDefault": true
        },
        "problemMatcher": []
      },
      {
        "label": "DB: Generate Client",
        "detail": "Sinh lại Prisma Client trong packages/web/server/db/generated từ schema.prisma",
        "type": "shell",
        "command": "pnpm db:generate",
        "problemMatcher": []
      },
      {
        "label": "DB: Validate Schema",
        "detail": "Kiểm tra cú pháp và tính hợp lệ của packages/web/prisma/schema.prisma",
        "type": "shell",
        "command": "pnpm --filter @math-insight/web db:validate",
        "problemMatcher": []
      },
      {
        "label": "DB: Migrate (Dev)",
        "detail": "Tạo và áp dụng Prisma migration trên môi trường dev (APP_ENV=development)",
        "type": "shell",
        "command": "pnpm db:migrate:dev",
        "problemMatcher": []
      },
      {
        "label": "DB: Migrate Deploy (Staging)",
        "detail": "Áp dụng các Prisma migration hiện có lên môi trường staging (APP_ENV=staging)",
        "type": "shell",
        "command": "pnpm db:migrate:staging",
        "problemMatcher": []
      },
      {
        "label": "DB: Migrate Deploy (Prod)",
        "detail": "Áp dụng các Prisma migration hiện có lên môi trường production (APP_ENV=production)",
        "type": "shell",
        "command": "pnpm db:migrate:prod",
        "problemMatcher": []
      },
      {
        "label": "DB: Seed Admin (Dev)",
        "detail": "Tạo/cập nhật tài khoản admin trên DB dev bằng ADMIN_PASSWORD từ env",
        "type": "shell",
        "command": "pnpm db:seed:dev",
        "problemMatcher": []
      },
      {
        "label": "DB: Seed Admin (Staging)",
        "detail": "Tạo/cập nhật tài khoản admin trên DB staging bằng ADMIN_PASSWORD từ env",
        "type": "shell",
        "command": "pnpm db:seed:staging",
        "problemMatcher": []
      },
      {
        "label": "DB: Seed Admin (Prod)",
        "detail": "Tạo/cập nhật tài khoản admin trên DB production bằng ADMIN_PASSWORD từ env",
        "type": "shell",
        "command": "pnpm db:seed:prod",
        "problemMatcher": []
      },
      {
        "label": "DB: Seed Demo Data (Dev)",
        "detail": "Nạp tài khoản admin (từ env), tài khoản mẫu và dữ liệu demo vào DB dev",
        "type": "shell",
        "command": "pnpm db:seed:demo",
        "problemMatcher": []
      },
      {
        "label": "DB: Studio (Dev)",
        "detail": "Mở Prisma Studio kết nối tới DB dev (APP_ENV=development)",
        "type": "shell",
        "command": "pnpm --filter @math-insight/web db:studio:dev",
        "isBackground": true,
        "problemMatcher": []
      },
      {
        "label": "DB: Studio (Staging)",
        "detail": "Mở Prisma Studio kết nối tới DB staging (APP_ENV=staging)",
        "type": "shell",
        "command": "pnpm --filter @math-insight/web db:studio:staging",
        "isBackground": true,
        "problemMatcher": []
      },
      {
        "label": "DB: Studio (Prod)",
        "detail": "Mở Prisma Studio kết nối tới DB production (APP_ENV=production)",
        "type": "shell",
        "command": "pnpm --filter @math-insight/web db:studio:prod",
        "isBackground": true,
        "problemMatcher": []
      }
    ]
  }
}
